# Copy to .env at the repo root:  cp .env.example .env
# Consumed by docker-compose, Prisma (via packages/database/prisma.config.ts),
# and the NestJS backend (via ConfigModule).

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=expense
POSTGRES_PASSWORD=expense
POSTGRES_DB=expense_tracker
POSTGRES_PORT=5432

# --- Prisma ---
# Must match the POSTGRES_* values above when using docker-compose.
DATABASE_URL="postgresql://expense:expense@localhost:5432/expense_tracker?schema=public"

# --- Auth ---
# Generate a real one for anything non-local:  openssl rand -base64 32
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="7d"

# --- Backend ---
API_PORT=3001
WEB_ORIGIN="http://localhost:3000"
