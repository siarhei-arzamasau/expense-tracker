# dependencies
node_modules/
.pnpm-store/

# builds
dist/
build/
.next/
out/
*.tsbuildinfo

# turborepo
.turbo/

# prisma generated client (regenerate with `pnpm db:generate`)
packages/database/src/generated/

# env — .env.example is intentionally tracked
.env
.env.*
!.env.example

# tests
coverage/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# agent tooling runtime state — .claude/ is tracked on purpose, these are not.
# .omc/skills/ is the exception: project-scoped skills are meant to be shared.
# The `**/` prefix matters: a bare `.omc/*` anchors to this file's directory, so
# agents that write state from a subdirectory cwd escape it.
**/.omc/*
!**/.omc/skills/
.omx/

# playwright mcp output — screenshots, snapshots and console logs from browser runs
.playwright-mcp/

# editors / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
