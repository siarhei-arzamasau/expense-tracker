# Copy to .env.local:  cp .env.example .env.local
#
# Next.js only reads .env files inside its own app directory, so this is
# separate from the root .env used by Docker, Prisma, and the backend.
# NEXT_PUBLIC_ vars are inlined into the client bundle — never put secrets here.

NEXT_PUBLIC_API_URL=http://localhost:3001/api
