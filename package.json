{
  "name": "expense-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Expense tracker monorepo — Next.js frontend, NestJS backend, PostgreSQL via Prisma",
  "license": "MIT",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:cov": "turbo run test:cov",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:fix": "oxlint --fix .",
    "db:generate": "pnpm --filter @expense-tracker/database db:generate",
    "db:migrate": "pnpm --filter @expense-tracker/database db:migrate",
    "db:deploy": "pnpm --filter @expense-tracker/database db:deploy",
    "db:studio": "pnpm --filter @expense-tracker/database db:studio",
    "db:seed": "pnpm --filter @expense-tracker/database db:seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "@expense-tracker/typescript-config": "workspace:*",
    "@types/node": "^24.13.3",
    "eslint-plugin-turbo": "^2.10.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.76.0",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3"
  }
}
