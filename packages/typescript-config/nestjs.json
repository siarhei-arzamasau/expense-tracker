{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "NestJS",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "strictPropertyInitialization": false,
    "isolatedModules": false,

    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "outDir": "./dist",
    "baseUrl": "./"
  }
}
